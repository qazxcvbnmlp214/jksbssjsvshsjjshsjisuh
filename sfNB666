-- ========== 防卡输入工具（节流，不狂点）==========
local _lastInputAt = 0
local function vClickScreen(x, y)
    local now = os.clock()
    if now - _lastInputAt < 0.01 then return end
    _lastInputAt = now
    pcall(function()
        VirtualInput:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.01)
        VirtualInput:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end
local function vClickGui(guiObj)
    if not guiObj then return end
    pcall(function()
        local p = guiObj.AbsolutePosition; local s = guiObj.AbsoluteSize
        if s.X > 2 and s.Y > 2 then vClickScreen(p.X + s.X/2, p.Y + s.Y/2) end
    end)
end
local function vPressKey(keyCode)
    local now = os.clock()
    if now - _lastInputAt < 0.015 then return end
    _lastInputAt = now
    pcall(function()
        VirtualInput:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.01)
        VirtualInput:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- ========== 轻量GUI扫描（只扫2层，防卡死）==========
local function scanTopGuiButtons(max)
    max = max or 20
    local r = {}
    pcall(function()
        for _, layer in ipairs(PlayerGui:GetChildren()) do
            if layer:IsA("LayerCollector") and layer.Enabled then
                for _, d in ipairs(layer:GetChildren()) do
                    if #r >= max then break end
                    if d:IsA("GuiButton") then
                        local vis = false; pcall(function() vis = d.Visible end)
                        if vis and d.AbsoluteSize.X > 6 and d.AbsoluteSize.Y > 6 then table.insert(r, d) end
                    else
                        -- 只多扫一层，绝不递归
                        for _, d2 in ipairs(d:GetChildren()) do
                            if #r >= max then break end
                            if d2:IsA("GuiButton") then
                                local vis2 = false; pcall(function() vis2 = d2.Visible end)
                                if vis2 and d2.AbsoluteSize.X > 6 and d2.AbsoluteSize.Y > 6 then table.insert(r, d2) end
                            end
                        end
                    end
                end
            end
            if #r >= max then break end
        end
    end)
    return r
end

-- ========== Remote 扫描 ==========
local function findRemoteByKeywords(...)
    local keys = {...}
    local found = {}
    local function match(name)
        if not name then return false end
        local n = tostring(name):lower()
        for _, k in ipairs(keys) do if n:find(k:lower()) then return true end end
        return false
    end
    local function scan(parent, depth)
        if depth > 5 then return end
        for _, c in ipairs(parent:GetChildren()) do
            if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") or c:IsA("BindableEvent") or c:IsA("BindableFunction") then
                if match(c.Name) then table.insert(found, c) end
            else
                scan(c, depth + 1)
            end
        end
    end
    scan(ReplicatedS, 0)
    return found
end

